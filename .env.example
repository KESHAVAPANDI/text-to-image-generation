# Copy this file to .env and edit the values you need.
# The app reads these at startup. Anything left unset uses the default shown.
# This file is an example only, it is never loaded as-is.

# Online mode (s4): Hugging Face model and LoRA adapter
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
LORA_ID=latent-consistency/lcm-lora-sdxl

# Offline mode (s5): local model folders. Use forward slashes on Windows too,
# or keep the defaults in s5 (offline)/app.py.
MODEL_PATH=C:/Users/kesha/models/sdxl
LORA_PATH=C:/Users/kesha/models/lcm_lora_sdxl

# Device: auto (CUDA if available, else CPU), cuda, or cpu
DEVICE=auto

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Generation defaults
DEFAULT_STEPS=4
DEFAULT_GUIDANCE=1.0
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
MAX_PROMPT_LENGTH=1000
